{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "production-web",
  "description": "Native mobile commands for the production SourceWeft web app loaded in the Android and iOS webviews.",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "remote": { "urls": ["https://sourceweft.com/*"] },
  "permissions": [
    "core:default",
    "apple-sign-in:default",
    "google-auth:default",
    "allow-mobile-info",
    "allow-open-external-url"
  ]
}

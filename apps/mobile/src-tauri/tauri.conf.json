{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SourceWeft Mobile",
  "version": "0.1.0",
  "identifier": "nicelab.sourceweft.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter web dev"
    },
    "devUrl": "http://0.0.0.0:3000",
    "frontendDist": "../placeholder-dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": ""
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "SourceWeft",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "create": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "host": "sourceweft",
          "pathPrefix": ["/"]
        }
      ]
    }
  }
}

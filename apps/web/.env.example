# SourceWeft web env defaults are optimized for OSS self-hosting.
# Paid checkout UI and hosted SaaS surfaces are hidden unless explicitly enabled.

# Core public URLs.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Auth UI. Google One Tap is off by default so OSS deploys do not need a Google
# client id. Enable only after configuring AUTH_GOOGLE_ONE_TAP_CLIENT_ID on the
# backend and adding this web origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_ONE_TAP_ENABLED=false
NEXT_PUBLIC_GOOGLE_ONE_TAP_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ONE_TAP_FEDCM_ENABLED=false
# Mobile native Google sign-in client id. Used only by the Tauri mobile host.
NEXT_PUBLIC_GOOGLE_MOBILE_CLIENT_ID=

# Analytics. GTM Container ID, e.g. GTM-XXXXXXX. Empty disables GTM.
# Configure GA4 Measurement ID, e.g. G-XXXXXXXXXX, inside the GTM container.
NEXT_PUBLIC_GTM_ID=

# Landing page version to render at /.
NEXT_PUBLIC_LANDING_VERSION=1

# SaaS / payment checkout UI. Keep false for OSS: usage and limits remain
# visible, but paid checkout, upgrade, and billing portal actions are hidden.
NEXT_PUBLIC_SOURCEWEFT_SAAS_ENABLED=false
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false

# Pricing display values, used only when SaaS/checkout UI is enabled.
# Prices are USD cents, e.g. 1200 = $12.00/mo.
NEXT_PUBLIC_PRICING_PRO_MONTHLY=1200
NEXT_PUBLIC_PRICING_PRO_YEARLY=9600
NEXT_PUBLIC_PRICING_TEAM_MONTHLY=4900
NEXT_PUBLIC_PRICING_TEAM_YEARLY=39200

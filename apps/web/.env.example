NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_GOOGLE_ONE_TAP_ENABLED=true
NEXT_PUBLIC_GOOGLE_ONE_TAP_CLIENT_ID=

# ── Landing Page ────────────────────────────────────────
# Landing page version to render at / (default: 1)
NEXT_PUBLIC_LANDING_VERSION=1

# ── Pricing ─────────────────────────────────────────────
# Prices in USD cents (e.g. 1200 = $12.00/mo, 9600 = $96.00/yr)
NEXT_PUBLIC_PRICING_PRO_MONTHLY=1200
NEXT_PUBLIC_PRICING_PRO_YEARLY=9600
NEXT_PUBLIC_PRICING_TEAM_MONTHLY=4900
NEXT_PUBLIC_PRICING_TEAM_YEARLY=39200

# Creem checkout product IDs
NEXT_PUBLIC_CREEM_PRODUCT_PRO_MONTHLY=
NEXT_PUBLIC_CREEM_PRODUCT_PRO_YEARLY=
NEXT_PUBLIC_CREEM_PRODUCT_TEAM_MONTHLY=
NEXT_PUBLIC_CREEM_PRODUCT_TEAM_YEARLY=

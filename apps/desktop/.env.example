VITE_API_BASE_URL=http://localhost:3001
VITE_DESKTOP_APP_ENV=local

# Native Windows desktop process environment (not Web/VITE configuration).
# niubash is bundled; Windows local execution needs no environment configuration.
# Approved commands run with the current user's file/network access.
# Optional administrator overrides; this file is not loaded by Rust.
# SOURCEWEFT_WINDOWS_TRUSTED_LOCAL_EXECUTION=false
# SOURCEWEFT_NIUBASH_PATH=C:/Tools/niubash/niu.exe

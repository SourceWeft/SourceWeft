# SourceWeft backend env defaults are optimized for OSS self-hosting.
# Core services start with payment/SaaS integrations disabled. Turn on each
# optional provider explicitly when deploying a hosted SaaS instance.

# Core app URLs and runtime.
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=3001
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sourceweft
REDIS_URL=redis://127.0.0.1:6379
JOB_QUEUE_NAME=sourceweft-jobs
WORKER_CONCURRENCY=2
DELIVERABLE_WORKER_CONCURRENCY=1
SCHEDULER_INTERVAL_MS=60000
# Model pricing catalog sync interval in milliseconds (default: 3600000 = 1 hour).
# MODEL_PRICING_SYNC_INTERVAL_MS=3600000

# Sandboxed QuickJS interpreter. Disabled by default. When enabled it is
# available to authenticated agent turns, with read-only access to /kb and
# /workfiles. Invalid or out-of-range values fail backend startup.
SOURCEWEFT_AGENT_INTERPRETER_ENABLED=false
# SOURCEWEFT_AGENT_INTERPRETER_EXECUTION_TIMEOUT_MS=3000
# SOURCEWEFT_AGENT_INTERPRETER_MEMORY_LIMIT_BYTES=33554432
# SOURCEWEFT_AGENT_INTERPRETER_MAX_STACK_SIZE_BYTES=327680
# SOURCEWEFT_AGENT_INTERPRETER_MAX_RESULT_CHARS=2000
# SOURCEWEFT_AGENT_INTERPRETER_MAX_PTC_CALLS_PER_EVAL=8
# SOURCEWEFT_AGENT_INTERPRETER_MAX_PTC_CALLS_PER_TURN=24
# SOURCEWEFT_AGENT_INTERPRETER_MAX_EVALS_PER_TURN=6
# SOURCEWEFT_AGENT_INTERPRETER_MAX_CONCURRENT_EVALS=4
# SOURCEWEFT_AGENT_INTERPRETER_MAX_CONCURRENT_PTC_PER_TURN=4
# SOURCEWEFT_AGENT_INTERPRETER_EVAL_QUEUE_TIMEOUT_MS=1000
# SOURCEWEFT_AGENT_INTERPRETER_PTC_CALL_TIMEOUT_MS=5000
# SOURCEWEFT_AGENT_INTERPRETER_MAX_CODE_CHARS=20000

# Proactive clarifying questions (Claude-Code-style askUser). On by default;
# set to false (or 0) to disable the askUser tool on the root + sub-agent graphs.
# SOURCEWEFT_AGENT_ASK_USER_ENABLED=true

# Builtin capability namespace (default: sourceweft). Change for white-label deployments.
# SOURCEWEFT_CAPABILITY_NAMESPACE=sourceweft

# Required secrets. Use strong, unique values outside local development.
# BETTER_AUTH_SECRET is mandatory at startup — the process will exit if unset.
MODEL_GATEWAY_ENCRYPTION_SECRET=replace_with_32_plus_char_model_secret
BETTER_AUTH_SECRET=replace_with_32_plus_char_auth_secret
BETTER_AUTH_LOG_LEVEL=info

# Source file storage (S3-compatible). Required for source upload/reparse.
S3_BUCKET=sourceweft-uploads
S3_REGION=us-east-1
# Optional custom endpoint for MinIO/R2/local S3-compatible services.
# For Cloudflare R2, use https://<account-id>.r2.cloudflarestorage.com and
# keep the bucket name only in S3_BUCKET.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# AWS_* takes precedence; S3_* aliases are provided for storage-only keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public static asset storage (S3-compatible Cloudflare R2). Used by manual
# blog sync for public images. Keep write credentials scoped to this bucket.
PUBLIC_S3_BUCKET=sourceweft-public-assets
PUBLIC_S3_REGION=auto
PUBLIC_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
PUBLIC_S3_ACCESS_KEY_ID=
PUBLIC_S3_SECRET_ACCESS_KEY=
PUBLIC_S3_FORCE_PATH_STYLE=true
PUBLIC_S3_BASE_URL=https://assets.sourceweft.com

# Manual Notion blog sync. Run with: pnpm --filter @sourceweft/backend blog:sync
NOTION_BLOG_API_KEY=
NOTION_BLOG_DATABASE_ID=
NOTION_BLOG_VERSION=2026-03-11
# Override Notion API base URL (default: https://api.notion.com).
# NOTION_API_BASE_URL=https://api.notion.com
BLOG_ASSET_MAX_BYTES=15728640

# Document parsing providers. OSS default uses the configured provider only.
# explicit: strictly use DOCUMENT_PARSE_PROVIDER.
# balanced/cost: text PDFs can use LangChain; scanned/mixed PDFs and images use DOCUMENT_PARSE_PROVIDER.
# quality: prefer DOCUMENT_PARSE_PROVIDER for PDFs/images.
DOCUMENT_PARSE_STRATEGY=explicit
# Case-insensitive; surrounding whitespace is ignored. Unset/blank defaults to pdf2markdown.
# Unknown nonblank values fail service startup. Correct historical typos before upgrading.
# Accepted IDs: langchain, pdf2markdown, docling, llamaparse, unstructured.
# Only langchain/pdf2markdown are implemented; the other three remain placeholders.
# vision is an internal image parsing path, not a selectable provider ID.
DOCUMENT_PARSE_PROVIDER=pdf2markdown
# Parser version applied to newly ingested sources. Lets a new parser version
# ship as the default without a code change. Defaults to v2-document-provider.
DOCUMENT_PARSE_DEFAULT_PARSER_VERSION=v2-document-provider
# Default chunk size (characters) for newly ingested sources. Defaults to 1000.
DOCUMENT_PARSE_DEFAULT_CHUNK_SIZE=1000

# Max embedding dimensions accepted by the vector store (PgVectorProvider
# ceiling). Raising it requires the HNSW indexes to support wider vectors.
# Defaults to 2000.
VECTOR_SEARCH_MAX_DIMENSIONS=2000

# PDF2Markdown provider. Required only when DOCUMENT_PARSE_PROVIDER=pdf2markdown.
PDF2MARKDOWN_API_KEY=
PDF2MARKDOWN_BASE_URL=https://pdf2markdown.io/api
PDF2MARKDOWN_OUTPUT=all
PDF2MARKDOWN_POLL_INITIAL_DELAY_MS=2000
PDF2MARKDOWN_POLL_MAX_DELAY_MS=15000
PDF2MARKDOWN_POLL_MAX_ATTEMPTS=40
PDF2MARKDOWN_REQUEST_TIMEOUT_MS=30000

# Optional web search/fetch provider. Leave empty to disable chat web tools.
ANYCRAWL_API_KEY=

# Alpha sandbox integration. Disabled by default for OSS/self-host deployments.
# When enabled, agent tool calls can run commands in an isolated provider
# sandbox. Set SOURCEWEFT_SANDBOX_TOOL_APPROVAL_ENABLED=true to require human
# approval before sandbox prepare, execute, and collect tool calls.
# SourceWeft no longer ships a local Daytona Docker Compose stack. Point these
# values at an external Daytona deployment. Do not enable until the provider URL,
# API key, TTL, timeout, and byte limits below are acceptable for your host.
SOURCEWEFT_SANDBOX_ENABLED=false
SOURCEWEFT_SANDBOX_TOOL_APPROVAL_ENABLED=false
SOURCEWEFT_SANDBOX_PROVIDER=daytona
SOURCEWEFT_SANDBOX_TTL_SECONDS=3600
SOURCEWEFT_SANDBOX_COMMAND_TIMEOUT_MS=120000
SOURCEWEFT_SANDBOX_MAX_OUTPUT_CHARS=80000
SOURCEWEFT_SANDBOX_MAX_PREPARE_FILE_BYTES=10485760
SOURCEWEFT_SANDBOX_MAX_PREPARE_TOTAL_BYTES=26214400
SOURCEWEFT_SANDBOX_MAX_COLLECT_FILE_BYTES=26214400
SOURCEWEFT_SANDBOX_MAX_COLLECT_TOTAL_BYTES=52428800
# The DAYTONA_* values below are read by the Daytona sandbox provider
# capability, not by the backend: SOURCEWEFT_SANDBOX_PROVIDER selects a provider
# by id, and the capability that declares that id owns its own settings. The
# names are unchanged, so nothing here needs re-configuring; installing a
# different provider capability means setting that provider's variables instead.
DAYTONA_API_URL=
DAYTONA_API_KEY=
# Required when SOURCEWEFT_SANDBOX_ENABLED=true. Set exactly one target:
# - DAYTONA_SANDBOX_SNAPSHOT: a snapshot name already registered in Daytona.
# - DAYTONA_SANDBOX_IMAGE: a registry image reference, such as ghcr.io/...:tag.
# To make Daytona use snapshots, create the snapshot first, then set its name.
# Video-presentation visual QA renders slide stills with @remotion/renderer
# inside this sandbox; the image/snapshot needs Chrome Headless Shell system
# deps (libnss3, libatk, libgbm, fonts). Without them the stills step is
# skipped gracefully and generation still succeeds.
DAYTONA_SANDBOX_SNAPSHOT=
DAYTONA_SANDBOX_IMAGE=
# The CF_SANDBOX_* values are read by the Cloudflare sandbox provider
# capability (SOURCEWEFT_SANDBOX_PROVIDER=cloudflare). Deploy the stock bridge
# worker with packages/sandbox-provider-cloudflare/bridge/deploy.sh — it prints
# both values. Egress is fully open by default on Cloudflare (no tier gating).
CF_SANDBOX_BRIDGE_URL=
CF_SANDBOX_API_KEY=

# Global model Provider activation and credentials are separate. A Provider is
# globally ready only when *_ENABLED is true and its declared key is present.
# *_API_BASE values override provider base URLs. For Cloudflare AI Gateway +
# OpenRouter, use:
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openrouter
# without request paths such as /chat/completions.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=
ORCAROUTER_ENABLED=false
ORCAROUTER_API_KEY=
ORCAROUTER_API_BASE=
# Custom global-config Providers. These variables have no effect unless a
# gateway in MODEL_GATEWAY_GLOBAL_CONFIG_PATH references them.
SILICONFLOW_ENABLED=false
SILICONFLOW_API_KEY=
DEEPINFRA_ENABLED=false
DEEPINFRA_API_KEY=
DEEPINFRA_API_BASE=
# DeepSeek first-party API. DEEPSEEK_API_BASE overrides the default
# https://api.deepseek.com endpoint.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
# Override the LiteLLM pricing data URL. Default:
# https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# LITELLM_PRICING_URL=

# Better Auth origins and optional OAuth providers.
# Backend and web origins are auto-included from NEXT_PUBLIC_API_BASE_URL and
# NEXT_PUBLIC_WEB_BASE_URL. Add only extra origins here.
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional extension id (32 lowercase chars). Leave empty unless packaging the
# browser extension; this also derives AUTH_EXTENSION_REDIRECT_URI and enables
# strict provisioning of the public PKCE OAuth client during db:migrate.
AUTH_EXTENSION_ID=
AUTH_EXTENSION_CLIENT_ID=sourceweft-extension
# AUTH_EXTENSION_REDIRECT_URI=https://<extension-id>.chromiumapp.org/provider_cb
# Google sign-in uses Better Auth's default callback:
# <NEXT_PUBLIC_API_BASE_URL>/api/auth/callback/google.
AUTH_GOOGLE_SIGNIN_WEB_CLIENT_ID=
AUTH_GOOGLE_SIGNIN_WEB_CLIENT_SECRET=
# Google One Tap and mobile IDs are accepted for ID-token based sign-in only.
AUTH_GOOGLE_ONE_TAP_CLIENT_ID=
AUTH_GOOGLE_MOBILE_CLIENT_ID=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_RP_NAME=SourceWeft

# Notion connector OAuth/webhooks. Webhook public base URL is optional when
# NOTION_REDIRECT_URI uses the same public origin; set it when webhook ingress
# uses a different public HTTPS host.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
CONNECTOR_WEBHOOK_PUBLIC_BASE_URL=
NOTION_WEBHOOK_SECRET=

# Extra origins for user-supplied BYOK LLM endpoints. System Provider base URLs
# already grant their own origin permission; activation/credentials stay separate.
# Exact origins only, no API paths. See docs/llm-network.md for SDK limitations.
# Example: '["http://model-service:8000","http://127.0.0.1:11434"]'
LLM_ALLOWED_INTERNAL_ORIGINS=[]

# Explicit NODE_ENV=development skips LLM/MCP endpoint address restrictions.
# Production, test and an omitted NODE_ENV enforce the origin rules here.
# Credentials, TLS and cross-origin redirect protection remain active in dev.
# MCP network permissions remain separate from per-user credentials.
# Exact origins only (scheme + host + port), no paths or wildcards.
# Example: '["http://mcp.internal:8080","https://sso.internal"]'
# With strict checks, [] permits public HTTPS only. List internal OAuth services separately.
MCP_ALLOWED_INTERNAL_ORIGINS=[]
# Optional OAuth settings; blank redirect uses <API base URL>/v1/mcp/oauth/callback.
MCP_OAUTH_REDIRECT_URL=
MCP_OAUTH_CLIENT_NAME=SourceWeft
# Optional pre-registered clients; secrets are only offered to their issuer.
# Example: '[{"issuer":"https://sso.internal","clientId":"sourceweft","clientSecret":"replace-me"}]'
MCP_OAUTH_CLIENTS=[]

# Mail. OSS default is console/noop and does not require a SaaS email provider.
# Set MAIL_PROVIDER=plunk and PLUNK_API_KEY for production delivery.
MAIL_PROVIDER=console
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=SourceWeft
PLUNK_API_BASE_URL=https://next-api.useplunk.com
PLUNK_API_KEY=

# OSS billing and quota. Metering and limit enforcement are enabled by default;
# payment checkout is disabled unless the SaaS billing block below is enabled.
BACKEND_BILLING_MODE=enforced
BACKEND_BILLING_SCOPE=individual_only
BACKEND_CREDITS_ENABLED=true
BACKEND_PAGES_ENABLED=true
BACKEND_BILLING_ENFORCE_LIMITS=true
BACKEND_DEFAULT_PLAN_FAMILY=individual_free
BACKEND_DEFAULT_MONTHLY_PAGES=300
BACKEND_DEFAULT_MONTHLY_CREDITS=3000
BACKEND_CREDIT_UNIT_USD=0.00125
BACKEND_CREDIT_MARKUP_RATE=0.25

# SaaS billing / payment checkout. Enable all required parts together:
# 1) SOURCEWEFT_SAAS_ENABLED=true
# 2) BACKEND_BILLING_PROVIDER=creem
# 3) BACKEND_TEAM_BILLING_ENABLED=true if selling team subscriptions
# 4) CREEM_API_KEY, CREEM_WEBHOOK_SECRET, and product ids
SOURCEWEFT_SAAS_ENABLED=false
BACKEND_BILLING_PROVIDER=none
BACKEND_TEAM_BILLING_ENABLED=false
BACKEND_BILLING_RECONCILE_ENABLED=false
BILLING_PRICE_INDIVIDUAL_PRO_MONTHLY_CENTS=1200
BILLING_PRICE_INDIVIDUAL_PRO_YEARLY_CENTS=9600
BILLING_PRICE_TEAM_STANDARD_MONTHLY_CENTS=4900
BILLING_PRICE_TEAM_STANDARD_YEARLY_CENTS=39200
BILLING_CREDIT_TOPUP_UNIT_AMOUNT=10000
BILLING_CREDIT_TOPUP_AMOUNT_CENTS=1250
BILLING_PAGE_TOPUP_UNIT_AMOUNT=1000
BILLING_PAGE_TOPUP_AMOUNT_CENTS=500
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_INDIVIDUAL_PRO_MONTHLY_PRODUCT_ID=
CREEM_INDIVIDUAL_PRO_YEARLY_PRODUCT_ID=
CREEM_TEAM_STANDARD_MONTHLY_PRODUCT_ID=
CREEM_TEAM_STANDARD_YEARLY_PRODUCT_ID=
CREEM_CREDIT_TOPUP_PRODUCT_ID=
CREEM_PAGE_TOPUP_PRODUCT_ID=

# Ops alerts. Disabled by default for OSS; set emails and enable for hosted ops.
BACKEND_ALERTS_ENABLED=false
OPS_ALERT_EMAILS=
OPS_ALERT_COOLDOWN_MINUTES=30
OPS_ALERT_MIN_LEVEL=warn

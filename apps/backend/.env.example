NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
BACKEND_API_PORT=3001
REDIS_URL=redis://127.0.0.1:6379
JOB_QUEUE_NAME=sourceweft-jobs
WORKER_CONCURRENCY=2
SCHEDULER_INTERVAL_MS=60000
BACKEND_SCHEDULER_EXAMPLE_JOB_ENABLED=false
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sourceweft

# Source file storage (S3-compatible)
# Required for source upload/reparse.
S3_BUCKET=sourceweft-uploads
S3_REGION=us-east-1
# Optional custom endpoint for MinIO/R2/local S3-compatible services.
S3_ENDPOINT=
# Set true for MinIO/localstack style path routing.
S3_FORCE_PATH_STYLE=false
# Uses AWS_* first, falls back to S3_* aliases.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional aliases if you do not want to use AWS_* names.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MODEL_GATEWAY_ENCRYPTION_SECRET=replace_with_strong_shared_secret
# Optional absolute/relative path for global gateway bootstrap JSON.
# MODEL_GATEWAY_GLOBAL_CONFIG_PATH=./config/model-gateway.global.json

# Better Auth core
BETTER_AUTH_SECRET=replace_with_32_plus_char_secret
BETTER_AUTH_LOG_LEVEL=info
# Optional extension id (32 lowercase chars). When set, trusted origins
# auto-include chrome-extension://<id> and https://<id>.chromiumapp.org,
# and AUTH_EXTENSION_REDIRECT_URI can be omitted.
AUTH_EXTENSION_ID=<your_extension_id>
# Comma-separated allowlist used by Better Auth.
# Backend and web origins are auto-included from NEXT_PUBLIC_API_BASE_URL + NEXT_PUBLIC_WEB_BASE_URL.
# Add only extra origins (for example extension/chromiumapp origins).
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth providers (AUTH_* keys are consumed by backend config)
# GitHub OAuth App (Developer settings):
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3001/api/auth/callback/github
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# One Tap (falls back to AUTH_GOOGLE_CLIENT_ID when empty)
AUTH_ONE_TAP_CLIENT_ID=

# Passkey
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_RP_NAME=SourceWeft

# Extension OAuth2 public client
AUTH_EXTENSION_CLIENT_ID=sourceweft-extension
# Must match chrome.identity.getRedirectURL("provider_cb")
# AUTH_EXTENSION_REDIRECT_URI=https://<extension-id>.chromiumapp.org/provider_cb

# Mail
MAIL_PROVIDER=plunk
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=SourceWeft
PLUNK_API_BASE_URL=https://next-api.useplunk.com
PLUNK_API_KEY=

# Billing switches
BACKEND_BILLING_MODE=shadow
BACKEND_BILLING_SCOPE=team_enabled
BACKEND_CREDITS_ENABLED=true
BACKEND_PAGES_ENABLED=true
BACKEND_BILLING_PROVIDER=creem
BACKEND_BILLING_ENFORCE_LIMITS=true
BACKEND_TEAM_BILLING_ENABLED=true
BACKEND_BILLING_RECONCILE_ENABLED=true

# Billing defaults
BACKEND_CREDIT_UNIT_USD=0.00125
BACKEND_CREDIT_MARKUP_RATE=0.25
BACKEND_DEFAULT_PLAN_FAMILY=individual_free
BACKEND_BILLING_CYCLE_ANCHOR_DAY=1

# Creem
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_TEAM_STANDARD_PRODUCT_ID=
CREEM_DEFAULT_SUCCESS_URL=http://localhost:3000/app/billing?checkout=success

# Ops alerts
BACKEND_ALERTS_ENABLED=true
OPS_ALERT_EMAILS=
OPS_ALERT_COOLDOWN_MINUTES=30
OPS_ALERT_MIN_LEVEL=warn

# Provider API keys (used by model-gateway global config)
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=

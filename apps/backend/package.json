{
  "name": "@sourceweft/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run check-types:build && tsup && node scripts/copy-runtime-assets.mjs",
    "dev": "concurrently -k -n api,worker,scheduler -c cyan,magenta,yellow \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev:scheduler\"",
    "dev:fast": "pnpm run dev:api",
    "dev:api": "NODE_ENV=development tsx watch src/api/main.ts",
    "dev:worker": "NODE_ENV=development tsx watch src/worker/main.ts",
    "dev:scheduler": "NODE_ENV=development tsx watch src/scheduler/main.ts",
    "start": "node dist/api.js",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "start:scheduler": "node dist/scheduler.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:changed": "vitest run --config vitest.config.ts --changed",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "db:generate": "pnpm --filter @sourceweft/db db:generate",
    "db:migrate": "pnpm run migrate:auth && pnpm --filter @sourceweft/db db:migrate && pnpm run auth:provision-extension",
    "migrate:auth": "auth migrate --yes --config src/modules/auth/auth.migration.ts",
    "auth:generate": "auth generate --config src/modules/auth/auth.migration.ts",
    "auth:provision-extension": "tsx src/scripts/provision-extension-oauth-client.ts",
    "migrate": "pnpm run db:migrate",
    "check": "tsx src/scripts/check.ts",
    "blog:sync": "tsx src/scripts/sync-notion-blog.ts",
    "creem:product:create": "tsx src/scripts/create-creem-product.ts",
    "creem:product:delete": "tsx src/scripts/delete-creem-product.ts",
    "mail:welcome": "tsx src/scripts/send-welcome-email.ts",
    "benchmark:video-render": "tsx src/scripts/benchmark-video-render.ts",
    "check-types": "tsc --noEmit",
    "check-types:build": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.67",
    "@anycrawl/js-sdk": "^0.0.5",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@better-auth/api-key": "1.7.2",
    "@better-auth/core": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@creem_io/better-auth": "^1.1.4",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@hono/node-server": "^1.19.17",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "1.5.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sourceweft/agent-interpreter": "workspace:*",
    "@sourceweft/agent-tool-registry": "workspace:*",
    "@sourceweft/builtin-connector-notion": "workspace:*",
    "@sourceweft/builtin-document-parsers": "workspace:*",
    "@sourceweft/builtin-retrieval": "workspace:*",
    "@sourceweft/builtin-skill-feynman": "workspace:*",
    "@sourceweft/builtin-skill-image-generate": "workspace:*",
    "@sourceweft/builtin-skill-meeting-summary": "workspace:*",
    "@sourceweft/builtin-skill-ppt-deck": "workspace:*",
    "@sourceweft/builtin-skill-video-presentation": "workspace:*",
    "@sourceweft/builtin-tool-sandbox": "workspace:*",
    "@sourceweft/builtin-tool-video-presentation": "workspace:*",
    "@sourceweft/builtin-tool-web-search": "workspace:*",
    "@sourceweft/builtin-vfs": "workspace:*",
    "@sourceweft/capability-contracts": "workspace:*",
    "@sourceweft/capability-runtime": "workspace:*",
    "@sourceweft/contracts": "workspace:*",
    "@sourceweft/credits-core": "workspace:*",
    "@sourceweft/db": "workspace:*",
    "@sourceweft/market-contracts": "workspace:*",
    "@sourceweft/market-sdk": "workspace:*",
    "@sourceweft/model-gateway": "workspace:*",
    "ai": "^6.0.253",
    "better-auth": "1.7.2",
    "bullmq": "^5.81.3",
    "deepagents": "1.13.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "epub2": "^3.0.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.2",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.11.1",
    "langchain": "^1.5.10",
    "mammoth": "^1.12.1",
    "music-metadata": "^11.14.0",
    "officeparser": "^7.5.1",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.35.3",
    "srt-parser-2": "^1.2.3",
    "unique-names-generator": "^4.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "4.1.7",
    "auth": "1.7.2",
    "concurrently": "^9.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "vitest": "4.1.7"
  }
}

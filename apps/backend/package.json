{
  "name": "@sourceweft/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run check-types && tsup && node scripts/copy-runtime-assets.mjs",
    "dev": "concurrently -k -n api,worker,scheduler -c cyan,magenta,yellow \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev:scheduler\"",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:scheduler": "tsx watch src/scheduler/main.ts",
    "start": "node dist/api.js",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "start:scheduler": "node dist/scheduler.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:changed": "vitest run --config vitest.config.ts --changed",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "db:generate": "pnpm --filter @sourceweft/db db:generate",
    "db:migrate": "pnpm run migrate:auth && pnpm --filter @sourceweft/db db:migrate",
    "migrate:auth": "auth migrate --yes --config src/modules/auth/auth.migration.ts",
    "auth:generate": "auth generate --config src/modules/auth/auth.migration.ts",
    "migrate": "pnpm run db:migrate",
    "check": "tsx src/scripts/check.ts",
    "blog:sync": "tsx src/scripts/sync-notion-blog.ts",
    "creem:product:create": "tsx src/scripts/create-creem-product.ts",
    "creem:product:delete": "tsx src/scripts/delete-creem-product.ts",
    "mail:welcome": "tsx src/scripts/send-welcome-email.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@anycrawl/js-sdk": "^0.0.5",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@better-auth/api-key": "1.6.10",
    "@better-auth/core": "1.6.10",
    "@better-auth/oauth-provider": "1.6.10",
    "@better-auth/passkey": "1.6.10",
    "@better-auth/utils": "0.4.0",
    "@creem_io/better-auth": "^1.1.0",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@hono/node-server": "^1.19.6",
    "@langchain/classic": "^1.0.36",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/langgraph-checkpoint": "^1.1.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.3",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.1",
    "@langchain/tavily": "^1.2.0",
    "@langchain/textsplitters": "^1.0.1",
    "@sourceweft/agent-tool-registry": "workspace:*",
    "@sourceweft/builtin-connector-notion": "workspace:*",
    "@sourceweft/builtin-document-parsers": "workspace:*",
    "@sourceweft/builtin-retrieval": "workspace:*",
    "@sourceweft/builtin-tool-generate-image": "workspace:*",
    "@sourceweft/builtin-tool-video-presentation": "workspace:*",
    "@sourceweft/builtin-tool-publish-artifact": "workspace:*",
    "@sourceweft/builtin-tool-sandbox": "workspace:*",
    "@sourceweft/builtin-tool-web-search": "workspace:*",
    "@sourceweft/builtin-vfs": "workspace:*",
    "@sourceweft/capability-contracts": "workspace:*",
    "@sourceweft/capability-runtime": "workspace:*",
    "@sourceweft/contracts": "workspace:*",
    "@sourceweft/credits-core": "workspace:*",
    "@sourceweft/db": "workspace:*",
    "@sourceweft/market-sdk": "workspace:*",
    "@sourceweft/model-gateway": "workspace:*",
    "@sourceweft/sandbox-provider-daytona": "workspace:*",
    "better-auth": "1.6.10",
    "bullmq": "^5.63.0",
    "deepagents": "^1.11.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "epub2": "^3.0.2",
    "hono": "^4.10.5",
    "html-to-text": "^9.0.5",
    "langchain": "^1.5.0",
    "langsmith": "^0.7.10",
    "mammoth": "^1.12.0",
    "officeparser": "^6.0.7",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.16.3",
    "pdf-parse": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.34.5",
    "srt-parser-2": "^1.2.3",
    "unique-names-generator": "^4.7.1",
    "yaml": "^2.8.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "4.1.7",
    "auth": "1.6.10",
    "concurrently": "^9.2.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "vitest": "4.1.7"
  }
}

{
  "name": "@sourceweft/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,scheduler -c cyan,magenta,yellow \"pnpm run dev:api\" \"pnpm run dev:worker\" \"pnpm run dev:scheduler\"",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx src/worker/main.ts",
    "dev:scheduler": "tsx src/scheduler/main.ts",
    "test": "node --test --import tsx src/modules/content/parsers/parsers.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "migrate:auth": "better-auth migrate --yes --config src/modules/auth/auth.ts",
    "migrate:workspace": "tsx src/scripts/migrate-workspace.ts",
    "migrate:billing-backfill": "tsx src/scripts/backfill-billing-accounts.ts",
    "migrate": "pnpm run migrate:auth && pnpm run db:migrate && pnpm run migrate:billing-backfill",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@better-auth/api-key": "^1.5.6",
    "@better-auth/oauth-provider": "^1.5.6",
    "@better-auth/passkey": "^1.5.6",
    "@chonkiejs/core": "^0.0.9",
    "@creem_io/better-auth": "^1.1.0",
    "@daveyplate/better-auth-ui": "^3.4.0",
    "@hono/node-server": "^1.19.6",
    "@langchain/classic": "^1.0.30",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.8",
    "@langchain/langgraph-checkpoint": "^1.0.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.1",
    "@langchain/openai": "^1.4.4",
    "@langchain/tavily": "^1.2.0",
    "@sourceweft/contracts": "workspace:*",
    "@sourceweft/credits-core": "workspace:*",
    "@sourceweft/model-gateway": "workspace:*",
    "better-auth": "^1.5.6",
    "bullmq": "^5.63.0",
    "deepagents": "^1.9.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "epub2": "^3.0.2",
    "hono": "^4.10.5",
    "html-to-text": "^9.0.5",
    "langchain": "^1.3.1",
    "mammoth": "^1.12.0",
    "officeparser": "^6.0.7",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "srt-parser-2": "^1.2.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}

# SourceWeft Docker defaults are optimized for OSS self-hosting.
# Payment, subscription checkout, hosted mail, OAuth, and model providers are
# optional. Leave optional values empty until you need the feature.

# Image published by .github/workflows/release.yml. For local builds, set:
# SOURCEWEFT_IMAGE=sourceweft:local-test
SOURCEWEFT_IMAGE=ghcr.io/sourceweft/sourceweft:v0.1.0
COMPOSE_PROFILES=local-storage

# Public URLs used by the browser and auth callbacks.
WEB_PORT=3000
# Set these only when using a hostname. Blank defaults to localhost:WEB_PORT.
PUBLIC_WEB_BASE_URL=
PUBLIC_API_BASE_URL=
# API/DB/Redis/storage ports are internal; browsers use the gateway only.

# Database and queue used by docker/docker-compose.yml.
DB_USER=sourceweft
DB_PASSWORD=GENERATED_BY_INIT
DB_NAME=sourceweft
# Optional external DB override; otherwise the container encodes DB_* safely.
DATABASE_URL=
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
JOB_QUEUE_NAME=sourceweft-jobs
WORKER_CONCURRENCY=2
DELIVERABLE_WORKER_CONCURRENCY=1

# Private source storage. Default local S3 service + idempotent bucket init.
S3_BUCKET=sourceweft-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://storage:8333
S3_ACCESS_KEY_ID=sourceweft
S3_SECRET_ACCESS_KEY=GENERATED_BY_INIT
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Web reads blog posts directly from Postgres. Backend manual sync writes them.
# Public blog images are uploaded to a separate public S3-compatible R2 bucket.
PUBLIC_S3_BUCKET=
PUBLIC_S3_REGION=auto
PUBLIC_S3_ENDPOINT=
PUBLIC_S3_ACCESS_KEY_ID=
PUBLIC_S3_SECRET_ACCESS_KEY=
PUBLIC_S3_FORCE_PATH_STYLE=true
PUBLIC_S3_BASE_URL=
NOTION_BLOG_API_KEY=
NOTION_BLOG_DATABASE_ID=
NOTION_BLOG_VERSION=2026-03-11

# Required secrets. Replace before exposing the deployment beyond localhost.
BETTER_AUTH_SECRET=GENERATED_BY_INIT
MODEL_GATEWAY_ENCRYPTION_SECRET=GENERATED_BY_INIT

# OSS quota defaults. Billing metering and limit enforcement are on by default,
# but payment checkout is off unless the SaaS block below is enabled.
SOURCEWEFT_COMMERCIAL_ENABLED=false
# BACKEND_BILLING_MODE=shadow # optional after enabling the commercial module
BACKEND_DEFAULT_MONTHLY_PAGES=300
BACKEND_DEFAULT_MONTHLY_CREDITS=3000

# Global model Provider activation and credentials are separate. OpenRouter is
# enabled by default but becomes globally ready only when its key is present.
# Additional providers can be declared by mounting a custom config and setting
# MODEL_GATEWAY_GLOBAL_CONFIG_PATH.
# OPENROUTER_API_BASE overrides the default OpenRouter endpoint. For Cloudflare
# AI Gateway, use:
# https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openrouter
# without request paths such as /chat/completions.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=
ORCAROUTER_ENABLED=false
ORCAROUTER_API_KEY=
ORCAROUTER_API_BASE=
# Custom global-config Provider example. These have no effect unless the
# mounted config references them.
DEEPINFRA_ENABLED=false
DEEPINFRA_API_KEY=
DEEPINFRA_API_BASE=

# Alpha sandbox integration. Disabled by default for OSS/self-host deployments.
# When enabled, agent tool calls can run commands in an isolated provider
# sandbox. Set SOURCEWEFT_SANDBOX_TOOL_APPROVAL_ENABLED=true to require human
# approval before sandbox prepare, execute, and collect tool calls. SourceWeft no
# longer ships a local Daytona Docker Compose stack; point the provider settings
# below at an external Daytona deployment. Do not enable until the provider URL,
# API key, TTL, timeout, and byte limits below are acceptable for your host.
SOURCEWEFT_SANDBOX_ENABLED=false
SOURCEWEFT_SANDBOX_TOOL_APPROVAL_ENABLED=false
SOURCEWEFT_SANDBOX_PROVIDER=daytona
SOURCEWEFT_SANDBOX_TTL_SECONDS=3600
SOURCEWEFT_SANDBOX_COMMAND_TIMEOUT_MS=120000
SOURCEWEFT_SANDBOX_MAX_OUTPUT_CHARS=80000
SOURCEWEFT_SANDBOX_MAX_PREPARE_FILE_BYTES=10485760
SOURCEWEFT_SANDBOX_MAX_PREPARE_TOTAL_BYTES=26214400
SOURCEWEFT_SANDBOX_MAX_COLLECT_FILE_BYTES=26214400
SOURCEWEFT_SANDBOX_MAX_COLLECT_TOTAL_BYTES=52428800
# External Daytona deployment URL and API key.
DAYTONA_API_URL=
DAYTONA_API_KEY=
# Required when SOURCEWEFT_SANDBOX_ENABLED=true. Set exactly one target:
# - DAYTONA_SANDBOX_SNAPSHOT: a snapshot name already registered in Daytona.
# - DAYTONA_SANDBOX_IMAGE: a registry image reference, such as ghcr.io/...:tag.
# To make Daytona use snapshots, create the snapshot first, then set its name.
DAYTONA_SANDBOX_SNAPSHOT=
DAYTONA_SANDBOX_IMAGE=

# Extra internal LLM origins for BYOK, independent of MCP/Provider activation.
# System Provider base URLs grant their own origin permission automatically.
# Use backend-reachable addresses; localhost is the backend container itself.
# Example: '["http://model-service:8000"]'
LLM_ALLOWED_INTERNAL_ORIGINS=[]

# Compose runs NODE_ENV=production and enforces LLM/MCP address restrictions.
# Backend dev commands skip those restrictions; authentication/TLS behavior is unchanged.
# MCP services on your private network.
# Exact origins only, including scheme/port; no API paths or wildcard hosts.
# Example: '["http://mcp-service:8080","https://sso.internal"]'
MCP_ALLOWED_INTERNAL_ORIGINS=[]
MCP_OAUTH_REDIRECT_URL=
MCP_OAUTH_CLIENT_NAME=SourceWeft
MCP_OAUTH_CLIENTS=[]

# Optional OAuth. Leave empty to use email/password auth only.
# Google sign-in uses Better Auth's default callback:
# <PUBLIC_API_BASE_URL>/api/auth/callback/google (same as the Web origin by default).
AUTH_GOOGLE_SIGNIN_WEB_CLIENT_ID=
AUTH_GOOGLE_SIGNIN_WEB_CLIENT_SECRET=
# Google One Tap and mobile IDs are accepted for ID-token based sign-in only.
AUTH_GOOGLE_ONE_TAP_CLIENT_ID=
AUTH_GOOGLE_MOBILE_CLIENT_ID=
PUBLIC_GOOGLE_ONE_TAP_ENABLED=false
PUBLIC_GOOGLE_ONE_TAP_CLIENT_ID=
PUBLIC_GOOGLE_ONE_TAP_FEDCM_ENABLED=false
PUBLIC_GOOGLE_MOBILE_CLIENT_ID=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Optional hosted mail. Default backend MAIL_PROVIDER is console/noop, so OSS
# deploys do not need a mail API key. Set these for production email delivery.
MAIL_PROVIDER=console
PLUNK_API_KEY=

# Optional web search/fetch provider. Ordinary chat does not require it.
# Explicit web-tool invocations fail clearly when it is unconfigured.
ANYCRAWL_API_KEY=

# SaaS billing / payment checkout. Enable all required parts together:
# 1) SOURCEWEFT_COMMERCIAL_ENABLED=true
# 2) SOURCEWEFT_SAAS_ENABLED=true
# 3) BACKEND_BILLING_PROVIDER=creem, waffo, or stripe
# 4) Test credentials for the selected provider below
SOURCEWEFT_SAAS_ENABLED=false
BACKEND_BILLING_PROVIDER=none
BACKEND_TEAM_BILLING_ENABLED=false
BACKEND_BILLING_RECONCILE_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_INDIVIDUAL_PRO_MONTHLY_PRODUCT_ID=
CREEM_INDIVIDUAL_PRO_YEARLY_PRODUCT_ID=
CREEM_TEAM_STANDARD_MONTHLY_PRODUCT_ID=
CREEM_TEAM_STANDARD_YEARLY_PRODUCT_ID=
CREEM_CREDIT_TOPUP_PRODUCT_ID=
CREEM_PAGE_TOPUP_PRODUCT_ID=

# AnyDoc is the sole document parser. Remove retired DOCUMENT_PARSE_PROVIDER
# and DOCUMENT_PARSE_STRATEGY values before upgrading.
DOCUMENT_PARSE_OCR_ENABLED=false
DOCUMENT_PARSE_OCR_PROVIDER=pdf2markdown
# Select one image policy explicitly; vision errors never switch to OCR.
DOCUMENT_PARSE_IMAGE_STRATEGY=vision
DOCUMENT_PARSE_DEFAULT_PARSER_VERSION=v4-anydoc-unified-0.2.4
PDF2MARKDOWN_API_KEY=
PDF2MARKDOWN_BASE_URL=https://pdf2markdown.io/api
PDF2MARKDOWN_OUTPUT=all

# Waffo Pancake: select BACKEND_BILLING_PROVIDER=waffo in the commercial edition.
# Merchant ID comes from API & Development, not a store URL. Use a TEST API Key first.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Optional (default test); API Key must be bound to the same environment.
# WAFFO_ENVIRONMENT=test

# Stripe hosted Checkout (commercial edition; BACKEND_BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Defaults to test. Set false only with a matching live secret key.
STRIPE_TEST_MODE=true

# Optional runtime analytics and landing variant.
PUBLIC_GTM_ID=
LANDING_VERSION=1

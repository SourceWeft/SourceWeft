# SourceWeft Docker defaults are optimized for OSS self-hosting.
# Payment, subscription checkout, hosted mail, OAuth, and model providers are
# optional. Leave optional values empty until you need the feature.

# Image published by .github/workflows/release.yml. For local builds, set:
# SOURCEWEFT_IMAGE=sourceweft:local-test
SOURCEWEFT_IMAGE=ghcr.io/sourceweft/sourceweft:latest

# Public URLs used by the browser and auth callbacks.
WEB_PORT=3000
BACKEND_API_PORT=3001
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Database and queue used by docker/docker-compose.yml.
DB_USER=sourceweft
DB_PASSWORD=sourceweft
DB_NAME=sourceweft
DATABASE_URL=postgresql://sourceweft:sourceweft@postgres:5432/sourceweft
REDIS_URL=redis://redis:6379/0

# Web reads blog posts directly from Postgres. Backend manual sync writes them.
# Public blog images are uploaded to a separate public S3-compatible R2 bucket.
PUBLIC_S3_BUCKET=sourceweft-public-assets
PUBLIC_S3_REGION=auto
PUBLIC_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
PUBLIC_S3_ACCESS_KEY_ID=
PUBLIC_S3_SECRET_ACCESS_KEY=
PUBLIC_S3_FORCE_PATH_STYLE=true
PUBLIC_S3_BASE_URL=https://assets.sourceweft.com
NOTION_BLOG_API_KEY=
NOTION_BLOG_DATABASE_ID=
NOTION_BLOG_VERSION=2026-03-11

# Required secrets. Replace before exposing the deployment beyond localhost.
BETTER_AUTH_SECRET=replace_with_32_plus_char_auth_secret
MODEL_GATEWAY_ENCRYPTION_SECRET=replace_with_32_plus_char_model_secret

# OSS quota defaults. Billing metering and limit enforcement are on by default,
# but payment checkout is off unless the SaaS block below is enabled.
BACKEND_BILLING_MODE=enforced
BACKEND_DEFAULT_MONTHLY_PAGES=300
BACKEND_DEFAULT_MONTHLY_CREDITS=3000

# Optional model provider keys. These are not required for the containers to
# start; model/chat calls will return the existing provider configuration error
# until at least one usable provider is configured.
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
SILICONFLOW_API_KEY=

# Optional OAuth. Leave empty to use email/password auth only.
# Google sign-in uses Better Auth's default callback:
# <NEXT_PUBLIC_API_BASE_URL>/api/auth/callback/google.
AUTH_GOOGLE_SIGNIN_WEB_CLIENT_ID=
AUTH_GOOGLE_SIGNIN_WEB_CLIENT_SECRET=
# Google One Tap and mobile IDs are accepted for ID-token based sign-in only.
AUTH_GOOGLE_ONE_TAP_CLIENT_ID=
AUTH_GOOGLE_MOBILE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ONE_TAP_ENABLED=false
NEXT_PUBLIC_GOOGLE_ONE_TAP_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ONE_TAP_FEDCM_ENABLED=false
NEXT_PUBLIC_GOOGLE_MOBILE_CLIENT_ID=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Optional future Google Workspace connectors. These are intentionally separate
# from sign-in credentials; self-hosters may manually reuse the same Google
# OAuth client if they accept the broader consent-screen scope.
GOOGLE_CONNECTORS_OAUTH_CLIENT_ID=
GOOGLE_CONNECTORS_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_GMAIL_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=

# Optional hosted mail. Default backend MAIL_PROVIDER is console/noop, so OSS
# deploys do not need a mail API key. Set these for production email delivery.
MAIL_PROVIDER=console
PLUNK_API_KEY=

# SaaS billing / payment checkout. Enable all required parts together:
# 1) SOURCEWEFT_SAAS_ENABLED=true
# 2) NEXT_PUBLIC_SOURCEWEFT_SAAS_ENABLED=true
# 3) NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=true
# 4) BACKEND_BILLING_PROVIDER=creem
# 5) CREEM_API_KEY, CREEM_WEBHOOK_SECRET, and product ids below
SOURCEWEFT_SAAS_ENABLED=false
NEXT_PUBLIC_SOURCEWEFT_SAAS_ENABLED=false
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false
BACKEND_BILLING_PROVIDER=none
BACKEND_TEAM_BILLING_ENABLED=false
BACKEND_BILLING_RECONCILE_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_INDIVIDUAL_PRO_MONTHLY_PRODUCT_ID=
CREEM_INDIVIDUAL_PRO_YEARLY_PRODUCT_ID=
CREEM_TEAM_STANDARD_MONTHLY_PRODUCT_ID=
CREEM_TEAM_STANDARD_YEARLY_PRODUCT_ID=
CREEM_CREDIT_TOPUP_PRODUCT_ID=
CREEM_PAGE_TOPUP_PRODUCT_ID=

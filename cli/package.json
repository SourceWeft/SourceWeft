{
  "name": "@sourceweft/cli",
  "license": "Apache-2.0",
  "version": "0.1.1",
  "description": "Install skills from the SourceWeft marketplace onto a local coding agent.",
  "keywords": [
    "skills",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SourceWeft/SourceWeft.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "sourceweft": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@sourceweft/eslint-config": "workspace:*",
    "@sourceweft/market-contracts": "workspace:*",
    "@sourceweft/skill-format": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "fflate": "^0.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "zod": "^4.4.3"
  }
}

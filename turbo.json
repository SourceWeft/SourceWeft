{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "tsconfig*.tsbuildinfo"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "^build"
      ],
      "outputs": [
        "tsconfig*.tsbuildinfo",
        ".next/types/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "MODEL_GATEWAY_ENCRYPTION_SECRET",
        "PDF2MARKDOWN_API_KEY"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:fast": {
      "cache": false,
      "persistent": true
    },
    "test:e2e:skills": {
      "cache": false,
      "env": [
        "SKILL_E2E_API_URL",
        "SKILL_E2E_WEB_URL",
        "SKILL_E2E_FIXTURES_FILE",
        "SKILL_E2E_REQUIRE_ALL"
      ]
    },
    "test:e2e:skills:full": {
      "cache": false,
      "env": [
        "SKILL_E2E_API_URL",
        "SKILL_E2E_WEB_URL",
        "SKILL_E2E_FIXTURES_FILE",
        "SKILL_E2E_REQUIRE_ALL"
      ]
    }
  }
}

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SOURCEWEFT_COMMERCIAL_ENABLED",
    "SOURCEWEFT_NEXT_DIST_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "tsconfig*.tsbuildinfo"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"],
      "outputs": ["tsconfig*.tsbuildinfo", ".next/types/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_SECRET",
        "MODEL_GATEWAY_ENCRYPTION_SECRET",
        "PDF2MARKDOWN_API_KEY"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:fast": {
      "cache": false,
      "persistent": true
    },
    "test:e2e:skills": {
      "cache": false,
      "env": [
        "SKILL_E2E_API_URL",
        "SKILL_E2E_WEB_URL",
        "SKILL_E2E_FIXTURES_FILE",
        "SKILL_E2E_REQUIRE_ALL"
      ]
    },
    "test:e2e:skills:full": {
      "cache": false,
      "env": [
        "SKILL_E2E_API_URL",
        "SKILL_E2E_WEB_URL",
        "SKILL_E2E_FIXTURES_FILE",
        "SKILL_E2E_REQUIRE_ALL"
      ]
    }
  },
  "globalPassThroughEnv": [
    "PUBLIC_*",
    "INTERNAL_API_BASE_URL",
    "SELFHOST_*",
    "LANDING_VERSION",
    "SOURCEWEFT_SAAS_ENABLED",
    "BACKEND_BILLING_*",
    "BACKEND_CREDITS_ENABLED",
    "BACKEND_PAGES_ENABLED",
    "BACKEND_TEAM_BILLING_ENABLED",
    "CREEM_*",
    "WAFFO_*",
    "STRIPE_*"
  ]
}

{
  "name": "sourceweft",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@sourceweft/extension --filter=!@sourceweft/desktop",
    "dev:chrome": "pnpm --filter @sourceweft/extension dev",
    "dev:desktop": "turbo run dev --filter=@sourceweft/desktop",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "^0.34.5",
    "turbo": "^2.8.20"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18"
  }
}

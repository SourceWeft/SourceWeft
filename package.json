{
  "name": "sourceweft",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@sourceweft/ui-web --filter=web --filter=@sourceweft/backend",
    "dev:web": "turbo run dev --filter=@sourceweft/ui-web --filter=web",
    "dev:backend": "pnpm --filter @sourceweft/backend dev",
    "dev:chrome": "pnpm --filter @sourceweft/extension dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:desktop": "turbo run dev --filter=@sourceweft/desktop",
    "dev:mobile": "turbo run dev --filter=@sourceweft/mobile",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "^0.34.5",
    "turbo": "^2.8.20"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@better-auth/core>better-call": "2",
        "@better-auth/passkey>better-call": "2",
        "@better-auth/oauth-provider>better-call": "2",
        "@browserbasehq/stagehand>dotenv": "17",
        "@browserbasehq/stagehand>openai": "6",
        "@browserbasehq/stagehand>zod": "4"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "msw",
      "protobufjs",
      "sharp",
      "spawn-sync",
      "tesseract.js"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}

{
  "schemaVersion": 1,
  "id": "sourceweft/video-presentation",
  "kind": "skill",
  "name": "Video Presentation",
  "description": "Author, validate, render, and atomically publish trusted MP4 video presentations with an autonomous root Agent skill.",
  "version": "1.0.0",
  "entry": "./src/index.ts",
  "skills": [
    {
      "id": "video-presentation",
      "visibility": "restricted",
      "defaultEnabled": false,
      "listing": "listed",
      "categories": ["create", "present", "visual"],
      "resources": [
        "SKILL.md",
        "references/brief-guidelines.md",
        "references/narration-guidelines.md",
        "references/visual-quality.md",
        "references/style-gallery.md",
        "references/draft-template.md"
      ],
      "options": [
        {
          "id": "stylePreset",
          "title": "Style",
          "description": "Default visual direction for the video project.",
          "valueType": "string",
          "defaultValue": "cinematic",
          "target": {
            "path": "config.renderProfile.stylePreset"
          },
          "values": [
            { "value": "cinematic", "label": "Cinematic" },
            { "value": "editorial", "label": "Editorial" },
            { "value": "executive", "label": "Executive" },
            { "value": "technical", "label": "Technical" },
            { "value": "product", "label": "Product" }
          ]
        },
        {
          "id": "visualDensity",
          "title": "Density",
          "description": "How much information each scene should carry.",
          "valueType": "string",
          "defaultValue": "balanced",
          "target": {
            "path": "config.renderProfile.visualDensity"
          },
          "values": [
            { "value": "light", "label": "Light" },
            { "value": "balanced", "label": "Balanced" },
            { "value": "dense", "label": "Dense" }
          ]
        },
        {
          "id": "durationTarget",
          "title": "Duration",
          "description": "Target pacing for the finished video presentation.",
          "valueType": "string",
          "defaultValue": "medium",
          "target": {
            "path": "config.renderProfile.durationTarget"
          },
          "values": [
            { "value": "short", "label": "Short" },
            { "value": "medium", "label": "Medium" },
            { "value": "long", "label": "Long" }
          ]
        },
        {
          "id": "slideCount",
          "title": "Slides",
          "description": "Target number of generated scenes/slides.",
          "valueType": "number",
          "target": {
            "path": "config.slideCount"
          },
          "values": [
            { "value": 4, "label": "4" },
            { "value": 6, "label": "6" },
            { "value": 8, "label": "8" },
            { "value": 10, "label": "10" }
          ]
        },
        {
          "id": "motionPacing",
          "title": "Motion",
          "description": "Default motion pacing for generated Remotion scenes.",
          "valueType": "string",
          "defaultValue": "dynamic",
          "target": {
            "path": "config.motion.pacing"
          },
          "values": [
            { "value": "calm", "label": "Calm" },
            { "value": "dynamic", "label": "Dynamic" },
            { "value": "energetic", "label": "Energetic" }
          ]
        },
        {
          "id": "canvasFps",
          "title": "FPS",
          "description": "Frames per second for the generated Remotion project.",
          "valueType": "number",
          "defaultValue": 30,
          "target": {
            "path": "config.canvas.fps"
          },
          "values": [
            { "value": 24, "label": "24" },
            { "value": 30, "label": "30" },
            { "value": 60, "label": "60" }
          ]
        },
        {
          "id": "language",
          "title": "Language",
          "description": "Main narration and scene language.",
          "valueType": "string",
          "defaultValue": "auto",
          "target": {
            "path": "config.renderProfile.language"
          },
          "values": [
            { "value": "auto", "label": "Auto" },
            { "value": "zh-CN", "label": "Chinese" },
            { "value": "en-US", "label": "English" }
          ]
        },
        {
          "id": "narrationEnabled",
          "title": "Narration",
          "description": "Generate narration audio for the video presentation.",
          "valueType": "boolean",
          "defaultValue": true,
          "target": {
            "path": "config.narration.enabled"
          },
          "values": []
        }
      ],
      "runtime": {
        "execution": "agent",
        "initialToolPolicy": "auto",
        "toolPolicy": {
          "allow": [
            "write_todos",
            "ls",
            "read_file",
            "write_file",
            "edit_file",
            "glob",
            "grep",
            "ask_user",
            "prepare_sandbox_workspace",
            "load_video_presentation",
            "generate_video_assets",
            "generate_video_narration",
            "validate_video_presentation",
            "publish_video_presentation"
          ],
          "deny": [
            "task",
            "generate_image",
            "execute",
            "collect_sandbox_outputs"
          ]
        },
        "tools": [
          "prepare_sandbox_workspace",
          "load_video_presentation",
          "generate_video_assets",
          "generate_video_narration",
          "validate_video_presentation",
          "publish_video_presentation"
        ],
        "permissionOverrides": {
          "prepare_sandbox_workspace": "allow",
          "load_video_presentation": "allow",
          "generate_video_assets": "allow",
          "generate_video_narration": "allow",
          "validate_video_presentation": "allow",
          "publish_video_presentation": "allow"
        },
        "output": {
          "kind": "artifact",
          "artifactType": "video_presentation",
          "publisherTool": "publish_video_presentation"
        },
        "requiredArguments": {
          "description": "video presentation brief",
          "clarificationPrompt": "Describe the topic, audience, and source material for the video presentation."
        },
        "promptIntro": "Use the video-presentation skill as a root Agent studio: plan with todos, author the canonical draft and Remotion scene modules in the sandbox, generate only the assets/narration that the plan needs, inspect validation evidence, repair files when evidence changes, and finish only through publish_video_presentation.",
        "additionalPromptLines": [
          "Read /skills/video-presentation/SKILL.md before authoring files or calling a video tool.",
          "Read a file under /skills/video-presentation/references/ only when SKILL.md's Quick Reference says the situation applies (rich source material, explicit length/language/voice asks, visual-style asks, or edits).",
          "For an edit, call load_video_presentation first and preserve its loadReceiptId and current version identity.",
          "Do not repeat an identical failed action. Change the draft from concrete diagnostics, choose another allowed action when evidence supports it, or stop with the blocker.",
          "A passed validate_video_presentation receipt, required three-frame scene samples, and a cover are mandatory before publication.",
          "Only publish_video_presentation may declare success. A processing, blocked, failed, or plain ready-shaped result is not success.",
          "The committed artifact must include the trusted sandbox-rendered MP4 and cover bound by the latest validation receipt."
        ]
      },
      "command": {
        "aliases": ["video-presentation", "video"],
        "category": "Artifacts",
        "iconName": "video-presentation"
      }
    }
  ]
}

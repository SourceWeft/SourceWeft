{
  "schemaVersion": 1,
  "id": "sourceweft/video-presentation",
  "kind": "skill",
  "name": "Video Presentation",
  "description": "Create narrated video presentation artifacts from source material with storyboard planning, visual asset planning, scene-code generation, audio narration, a rendered preview image, and browser-based preview/export.",
  "version": "1.2.0",
  "entry": "./src/index.ts",
  "skills": [
    {
      "id": "video-presentation",
      "visibility": "restricted",
      "listing": "listed",
      "categories": ["create", "present", "visual"],
      "resources": [
        "SKILL.md",
        "references/brief-guidelines.md",
        "references/narration-guidelines.md",
        "references/visual-quality.md",
        "references/style-gallery.md"
      ],
      "options": [
        {
          "id": "stylePreset",
          "title": "Style",
          "description": "Default visual direction for the video project.",
          "valueType": "string",
          "defaultValue": "cinematic",
          "target": {
            "toolName": "generate_video_presentation",
            "path": "renderProfile.stylePreset"
          },
          "values": [
            { "value": "cinematic", "label": "Cinematic" },
            { "value": "editorial", "label": "Editorial" },
            { "value": "executive", "label": "Executive" },
            { "value": "technical", "label": "Technical" },
            { "value": "product", "label": "Product" }
          ]
        },
        {
          "id": "visualDensity",
          "title": "Density",
          "description": "How much information each scene should carry.",
          "valueType": "string",
          "defaultValue": "balanced",
          "target": {
            "toolName": "generate_video_presentation",
            "path": "renderProfile.visualDensity"
          },
          "values": [
            { "value": "light", "label": "Light" },
            { "value": "balanced", "label": "Balanced" },
            { "value": "dense", "label": "Dense" }
          ]
        },
        {
          "id": "durationTarget",
          "title": "Duration",
          "description": "Target pacing for the finished video presentation.",
          "valueType": "string",
          "defaultValue": "medium",
          "target": {
            "toolName": "generate_video_presentation",
            "path": "renderProfile.durationTarget"
          },
          "values": [
            { "value": "short", "label": "Short" },
            { "value": "medium", "label": "Medium" },
            { "value": "long", "label": "Long" }
          ]
        },
        {
          "id": "slideCount",
          "title": "Slides",
          "description": "Target number of generated scenes/slides.",
          "valueType": "number",
          "target": {
            "toolName": "generate_video_presentation",
            "path": "slideCount"
          },
          "values": [
            { "value": 4, "label": "4" },
            { "value": 6, "label": "6" },
            { "value": 8, "label": "8" },
            { "value": 10, "label": "10" }
          ]
        },
        {
          "id": "motionPacing",
          "title": "Motion",
          "description": "Default motion pacing for generated Remotion scenes.",
          "valueType": "string",
          "defaultValue": "dynamic",
          "target": {
            "toolName": "generate_video_presentation",
            "path": "motion.pacing"
          },
          "values": [
            { "value": "calm", "label": "Calm" },
            { "value": "dynamic", "label": "Dynamic" },
            { "value": "energetic", "label": "Energetic" }
          ]
        },
        {
          "id": "canvasFps",
          "title": "FPS",
          "description": "Frames per second for the generated Remotion project.",
          "valueType": "number",
          "defaultValue": 30,
          "target": {
            "toolName": "generate_video_presentation",
            "path": "canvas.fps"
          },
          "values": [
            { "value": 24, "label": "24" },
            { "value": 30, "label": "30" },
            { "value": 60, "label": "60" }
          ]
        },
        {
          "id": "language",
          "title": "Language",
          "description": "Main narration and scene language.",
          "valueType": "string",
          "defaultValue": "auto",
          "target": {
            "toolName": "generate_video_presentation",
            "path": "renderProfile.language"
          },
          "values": [
            { "value": "auto", "label": "Auto" },
            { "value": "zh-CN", "label": "Chinese" },
            { "value": "en-US", "label": "English" }
          ]
        },
        {
          "id": "narrationEnabled",
          "title": "Narration",
          "description": "Generate narration audio for the video presentation.",
          "valueType": "boolean",
          "defaultValue": true,
          "target": {
            "toolName": "generate_video_presentation",
            "path": "narration.enabled"
          },
          "values": []
        }
      ],
      "runtime": {
        "execution": "agent",
        "tools": ["generate_video_presentation"],
        "permissionOverrides": {
          "generate_video_presentation": "allow"
        },
        "output": {
          "kind": "artifact",
          "artifactType": "video_presentation",
          "publisherTool": "generate_video_presentation"
        },
        "requiredArguments": {
          "description": "video presentation brief",
          "clarificationPrompt": "Describe the topic, audience, and source material for the video presentation."
        },
        "promptIntro": "Create a SourceWeft narrated video presentation artifact by following the video-presentation skill workflow and calling generate_video_presentation with a concise brief-first payload plus optional slideCount/visualDirection/brand/motion/canvas constraints. Do not pass a storyboard, blueprint, slide list, scene code, TSX, or HTML; the worker plans and builds the Remotion project internally. The command is complete only after generate_video_presentation returns a ready worker-built video project.",
        "additionalPromptLines": [
          "Read /skills/video-presentation/SKILL.md before calling generate_video_presentation.",
          "Read a file under /skills/video-presentation/references/ only when SKILL.md's Quick Reference says the situation applies (rich source material, explicit length/language/voice asks, visual-style asks, or edits).",
          "Only pass brief plus optional title/sourceDigest/audience/tone/language/stylePreset/durationTarget/renderProfile/slideCount/visualDirection/brand/motion/canvas/narrationEnabled/narration/assets/regeneration.",
          "Do not claim the final MP4/WebM has been rendered server-side; browser export happens from the ready artifact preview.",
          "If generate_video_presentation returns a processing/still-generating result, do not call it again for the same request; report that generation continues in the background.",
          "The pipeline stores a cover still as the artifact preview image automatically; it is best-effort and may be absent, so never promise a thumbnail."
        ]
      },
      "command": {
        "aliases": ["video-presentation", "video"],
        "category": "Artifacts",
        "iconName": "video-presentation"
      }
    }
  ]
}

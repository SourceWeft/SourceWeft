{
  "schemaVersion": 1,
  "id": "sourceweft/webdav",
  "kind": "connector",
  "name": "WebDAV Connector",
  "version": "0.1.0",
  "entry": "./src/index.ts",
  "connectors": [
    {
      "id": "webdav",
      "title": "WebDAV",
      "auth": {
        "kind": "credential",
        "scheme": "basic"
      },
      "sync": {
        "supportsIncremental": false,
        "defaultFrequencyMinutes": 360,
        "minFrequencyMinutes": 60,
        "resources": [
          {
            "type": "webdav_file",
            "title": "WebDAV file",
            "supportsDeleteDetection": true
          }
        ]
      },
      "actions": [
        {
          "id": "webdav.browse",
          "title": "Browse WebDAV",
          "description": "List the folders of a WebDAV collection so the user can choose root folders for this connector.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "containerId": {
                "type": ["string", "null"],
                "pattern": "^/[^\\u0000-\\u001F]{0,511}$"
              }
            }
          }
        },
        {
          "id": "webdav.describe",
          "title": "Describe WebDAV folders",
          "description": "Return the display name and existence of the selected WebDAV folders.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ids"],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^/[^\\u0000-\\u001F]{0,511}$"
                }
              }
            }
          }
        }
      ],
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpoint", "roots"],
        "properties": {
          "endpoint": {
            "type": "string",
            "pattern": "^https?://[^/?#@\\s]{1,253}(/[^?#\\s]{0,1790})?$"
          },
          "roots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/[^\\u0000-\\u001F]{0,511}$"
            }
          }
        }
      },
      "selection": {
        "actions": {
          "browse": "webdav.browse",
          "describe": "webdav.describe"
        },
        "kinds": ["folder"],
        "maxItems": 20
      }
    },
    {
      "id": "nextcloud",
      "title": "Nextcloud",
      "auth": {
        "kind": "credential",
        "scheme": "basic"
      },
      "sync": {
        "supportsIncremental": false,
        "defaultFrequencyMinutes": 360,
        "minFrequencyMinutes": 60,
        "resources": [
          {
            "type": "nextcloud_file",
            "title": "Nextcloud file",
            "supportsDeleteDetection": true
          }
        ]
      },
      "actions": [
        {
          "id": "nextcloud.browse",
          "title": "Browse Nextcloud",
          "description": "List the folders of a Nextcloud account so the user can choose root folders for this connector.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "containerId": {
                "type": ["string", "null"],
                "pattern": "^/[^\\u0000-\\u001F]{0,511}$"
              }
            }
          }
        },
        {
          "id": "nextcloud.describe",
          "title": "Describe Nextcloud folders",
          "description": "Return the display name and existence of the selected Nextcloud folders.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ids"],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^/[^\\u0000-\\u001F]{0,511}$"
                }
              }
            }
          }
        }
      ],
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["server", "endpoint", "userId", "roots"],
        "properties": {
          "server": {
            "type": "string",
            "pattern": "^https?://[^/?#@\\s]{1,253}(/[^?#\\s]{0,1790})?$"
          },
          "endpoint": {
            "type": "string",
            "pattern": "^https?://[^/?#@\\s]{1,253}(/[^?#\\s]{0,1790})?$"
          },
          "userId": {
            "type": "string",
            "pattern": "^[^\\u0000-\\u001F]{1,255}$"
          },
          "roots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/[^\\u0000-\\u001F]{0,511}$"
            }
          }
        }
      },
      "selection": {
        "actions": {
          "browse": "nextcloud.browse",
          "describe": "nextcloud.describe"
        },
        "kinds": ["folder"],
        "maxItems": 20
      }
    }
  ]
}

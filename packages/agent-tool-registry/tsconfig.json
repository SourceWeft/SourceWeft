      "@sourceweft/builtin-tool-publish-sandbox-artifact": ["../builtin-tool-publish-sandbox-artifact/src/index.ts"],
      "@sourceweft/builtin-tool-sandbox": ["../builtin-tool-sandbox/src/index.ts"],
      "@sourceweft/builtin-tool-web-search": ["../builtin-tool-web-search/src/index.ts"],
      "@sourceweft/builtin-vfs": ["../builtin-vfs/src/index.ts"],

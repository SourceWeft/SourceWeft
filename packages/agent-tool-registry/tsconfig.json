    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sourceweft/builtin-connector-notion": ["../builtin-connector-notion/src/index.ts"],
      "@sourceweft/builtin-retrieval": ["../builtin-retrieval/src/index.ts"],
      "@sourceweft/builtin-tool-generate-image": ["../builtin-tool-generate-image/src/index.ts"],

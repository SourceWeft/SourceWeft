{
  "schemaVersion": 1,
  "id": "sourceweft/confluence",
  "kind": "connector",
  "name": "Confluence Connector",
  "version": "0.1.0",
  "entry": "./src/index.ts",
  "connectors": [
    {
      "id": "confluence",
      "title": "Confluence",
      "auth": {
        "kind": "oauth2",
        "authorizationUrl": "https://auth.atlassian.com/authorize",
        "tokenUrl": "https://auth.atlassian.com/oauth/token",
        "scopes": [
          "read:space:confluence",
          "read:page:confluence",
          "read:content-details:confluence",
          "read:me",
          "offline_access"
        ],
        "authorizationParams": {
          "audience": "api.atlassian.com",
          "prompt": "consent"
        },
        "sendScope": true
      },
      "sync": {
        "supportsIncremental": false,
        "defaultFrequencyMinutes": 360,
        "resources": []
      },
      "actions": [
        {
          "id": "confluence.browse",
          "title": "Browse Confluence",
          "description": "List Confluence sites, then the spaces within a site and the pages within a space or page, so the user can choose spaces and pages for this connector.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "containerId": {
                "type": ["string", "null"],
                "pattern": "^site:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$|^space:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]{1,20}$|^page:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]{1,20}$"
              },
              "cursor": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        {
          "id": "confluence.search",
          "title": "Search Confluence",
          "description": "Search Confluence space names and page titles so the user can choose spaces and pages for this connector.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "cursor": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        {
          "id": "confluence.describe",
          "title": "Describe Confluence items",
          "description": "Return the name and existence of selected Confluence spaces and pages.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ids"],
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^(space|page):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]{1,20}$"
                }
              }
            }
          }
        },
        {
          "id": "confluence.content.search",
          "title": "Search Confluence pages",
          "agentToolName": "search_confluence",
          "description": "Search Confluence pages across the spaces and pages chosen in this connector's settings. Results are limited to that choice. Pass `cursor` from a prior result's `nextCursor` to continue. Cite the returned `url` for each page.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "agent",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Words to search for in page titles and bodies."
              },
              "spaceKeys": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_~.-]{1,255}$"
                },
                "description": "Limit the search to these space keys (for example [\"ENG\"]). Use keys from list_confluence_spaces; a key that is not selected matches nothing."
              },
              "updatedWithinDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365,
                "description": "Only pages updated in the last N days (1 to 365)."
              },
              "cursor": {
                "type": "string",
                "maxLength": 4096,
                "description": "Pass the previous result's nextCursor with the same other parameters to get the next page."
              }
            }
          }
        },
        {
          "id": "confluence.page.read",
          "title": "Read Confluence page",
          "agentToolName": "read_confluence_page",
          "description": "Read one Confluence page by id, limited to the spaces and pages chosen in this connector's settings. Cite the returned `url`.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "agent",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pageId"],
            "properties": {
              "pageId": {
                "type": "string",
                "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:)?[0-9]{1,20}$",
                "description": "The page id from a search result, for example \"<cloudId>:123456\", or a bare numeric page id."
              }
            }
          }
        },
        {
          "id": "confluence.space.list",
          "title": "List Confluence spaces",
          "agentToolName": "list_confluence_spaces",
          "description": "List the Confluence spaces chosen in this connector's settings, and the spaces that hold the chosen pages.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "agent",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        }
      ],
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(space|page):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]{1,20}$"
                },
                "kind": {
                  "type": "string",
                  "enum": ["space", "page"]
                }
              }
            }
          }
        },
        "default": {
          "items": []
        }
      },
      "selection": {
        "actions": {
          "browse": "confluence.browse",
          "search": "confluence.search",
          "describe": "confluence.describe"
        },
        "kinds": ["site", "space", "page"],
        "maxItems": 100
      }
    }
  ]
}

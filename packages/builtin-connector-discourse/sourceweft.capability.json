{
  "schemaVersion": 1,
  "id": "sourceweft/discourse",
  "kind": "connector",
  "name": "Discourse Connector",
  "version": "0.1.0",
  "entry": "./src/index.ts",
  "connectors": [
    {
      "id": "discourse",
      "title": "Discourse forum",
      "auth": {
        "kind": "none"
      },
      "sync": {
        "supportsIncremental": false,
        "defaultFrequencyMinutes": 360,
        "minFrequencyMinutes": 60,
        "resources": [
          {
            "type": "discourse_topic",
            "title": "Forum topic",
            "supportsDeleteDetection": true
          }
        ]
      },
      "actions": [
        {
          "id": "discourse.browse",
          "title": "Browse Discourse",
          "description": "List the categories of a Discourse forum, or the topics of one category, so the user can choose what to index.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "containerId": {
                "type": ["string", "null"],
                "pattern": "^[1-9][0-9]{0,9}$"
              },
              "cursor": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        {
          "id": "discourse.search",
          "title": "Search Discourse",
          "description": "Search the topics of a Discourse forum so the user can choose which to index.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "cursor": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        },
        {
          "id": "discourse.describe",
          "title": "Describe Discourse items",
          "description": "Return the name, kind and existence of the selected Discourse categories and topics.",
          "capabilities": ["connector_read"],
          "risk": "low",
          "requiresApproval": false,
          "visibility": "internal",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "kind"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,9}$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": ["category", "topic"]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "configSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["forumUrl"],
        "properties": {
          "forumUrl": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]{1,253}(/[A-Za-z0-9._~/-]{0,300})?$"
          },
          "items": {
            "type": "array",
            "default": [],
            "maxItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,9}$"
                },
                "kind": {
                  "type": "string",
                  "enum": ["category", "topic"]
                }
              }
            }
          },
          "refresh": {
            "type": "string",
            "enum": ["light", "deep"],
            "default": "light"
          }
        }
      },
      "selection": {
        "actions": {
          "browse": "discourse.browse",
          "search": "discourse.search",
          "describe": "discourse.describe"
        },
        "kinds": ["category", "topic"],
        "maxItems": 500
      }
    }
  ]
}

{
  "schemaVersion": 1,
  "id": "sourceweft/ppt-deck",
  "kind": "skill",
  "name": "PPT Deck",
  "description": "Generate, edit, and read PowerPoint presentations. Create from scratch with PptxGenJS, edit existing PPTX via XML workflows, or extract text with markitdown.",
  "version": "1.0.0",
  "entry": "./src/index.ts",
  "skills": [
    {
      "id": "ppt-deck",
      "visibility": "restricted",
      "defaultEnabled": true,
      "listing": "listed",
      "categories": ["create", "present"],
      "options": [
        {
          "id": "stylePreset",
          "title": "Style",
          "description": "Visual style direction for the deck.",
          "valueType": "string",
          "defaultValue": "auto",
          "target": { "path": "config.stylePreset" },
          "values": [
            { "value": "auto", "label": "Auto" },
            { "value": "executive", "label": "Executive" },
            { "value": "product", "label": "Product" },
            { "value": "academic", "label": "Academic" },
            { "value": "training", "label": "Training" },
            { "value": "minimal", "label": "Minimal" },
            { "value": "editorial", "label": "Editorial" }
          ]
        },
        {
          "id": "visualDensity",
          "title": "Density",
          "description": "How much information to place on each slide.",
          "valueType": "string",
          "defaultValue": "balanced",
          "target": { "path": "config.visualDensity" },
          "values": [
            { "value": "light", "label": "Light" },
            { "value": "balanced", "label": "Balanced" },
            { "value": "dense", "label": "Dense" }
          ]
        },
        {
          "id": "slideCount",
          "title": "Slides",
          "description": "Target number of slides.",
          "valueType": "number",
          "target": { "path": "config.slideCount" },
          "values": [
            { "value": 6, "label": "6" },
            { "value": 10, "label": "10" },
            { "value": 15, "label": "15" },
            { "value": 20, "label": "20" }
          ]
        },
        {
          "id": "language",
          "title": "Language",
          "description": "Deck language.",
          "valueType": "string",
          "defaultValue": "auto",
          "target": { "path": "config.language" },
          "values": [
            { "value": "auto", "label": "Auto" },
            { "value": "zh-CN", "label": "Chinese" },
            { "value": "en-US", "label": "English" }
          ]
        }
      ],
      "runtime": {
        "tools": [
          "prepare_sandbox_workspace",
          "execute",
          "generate_image",
          "review_deck_visuals",
          "publish_artifact"
        ],
        "permissionOverrides": {
          "generate_image": "allow",
          "review_deck_visuals": "allow"
        },
        "output": {
          "kind": "artifact",
          "artifactType": "slides",
          "publisherTool": "publish_artifact"
        }
      },
      "command": {
        "aliases": ["ppt", "slides", "deck", "presentation"],
        "category": "Artifacts",
        "iconName": "presentation"
      }
    }
  ]
}

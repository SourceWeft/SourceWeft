FROM ubuntu:22.04
ARG NODE_VERSION=24.18.0
ARG RUST_VERSION=1.94.1
ENV DEBIAN_FRONTEND=noninteractive
COPY scripts/ci/install-desktop-linux-deps.sh /tmp/install-deps.sh
RUN bash /tmp/install-deps.sh && rm -rf /var/lib/apt/lists/*
RUN curl --fail --silent --show-error --location "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz \
 && curl --fail --silent --show-error --location "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o /tmp/node-shasums \
 && cd /tmp \
 && awk -v name="node-v${NODE_VERSION}-linux-x64.tar.xz" '$2 == name { print $1 "  node.tar.xz" }' node-shasums > node.sha256 \
 && test -s node.sha256 && sha256sum --check node.sha256 \
 && tar -xJf node.tar.xz -C /usr/local --strip-components=1 \
 && rm node.tar.xz node-shasums node.sha256
RUN curl --proto '=https' --tlsv1.2 --fail --silent --show-error https://sh.rustup.rs -o /tmp/rustup-init.sh \
 && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}" \
 && rm /tmp/rustup-init.sh
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustc --version && cargo --version
RUN npm install --global @tauri-apps/cli@2.11.4
ENV APPIMAGE_EXTRACT_AND_RUN=1
WORKDIR /work/apps/desktop
